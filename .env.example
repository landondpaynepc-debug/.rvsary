# Never share your bot token or commit your .env file.
DISCORD_TOKEN=
GUILD_ID=
# Optional: leaving GUILD_ID empty detects the server from the verification channel.

VERIFICATION_CHANNEL_ID=1503856051232182294
DASHBOARD_CHANNEL_ID=1492006832779165756
TICKET_DESTINATION_ID=1568501776125009984
WELCOME_CHANNEL_ID=1492026750329163776
CAREERS_CHANNEL_ID=1492245276201582763
MOD_LOG_CHANNEL_ID=1492018824441102517
EVENT_LOG_CHANNEL_ID=1492018836898054226
APPLICATION_REVIEW_CHANNEL_ID=1492019040082985110
APPLICATION_LOG_CHANNEL_ID=1492019040082985110
# Keep old review buttons working for applications posted before the channel move.
LEGACY_APPLICATION_REVIEW_CHANNEL_ID=1492019111142887434
APPLICATION_REVIEWER_ROLE_ID=1492001472416845987
APPLICATION_ADDITIONAL_REVIEWER_ROLE_ID=1494522719851643020
SUPPORT_APPLICATION_ROLE_ID=1491994140819324988
MANAGEMENT_APPLICATION_ROLE_ID=1492001472416845987
DESIGN_ROLE_ID=1507979010053771354
GFX_ROLE_ID=1507984459839045762
VFX_ROLE_ID=1492013251700064307
DISCORD_SERVICES_ROLE_ID=1492013217692778616
# auto detects the app's Message Content access. Enable that intent in the
# Developer Portal for message-text logs and /clear contains, then restart.
# false disables text logging; true explicitly requests the privileged intent.
ENABLE_MESSAGE_CONTENT=auto

# New joins receive the first role; Verify adds the second and removes the first.
UNVERIFIED_ROLE_ID=1492018455359127643
VERIFIED_ROLE_ID=1491987224835784754

# Your support staff role ID (already configured).
SUPPORT_ROLE_ID=1491987441702142074
# Optional; defaults to SUPPORT_ROLE_ID when empty.
MANAGEMENT_ROLE_ID=

# Optional direct HTTPS image URLs. Bundled blue banners are used by default.
VERIFICATION_BANNER_URL=
DASHBOARD_BANNER_URL=

# On Render, attach a persistent disk at /var/data and set DATA_DIR=/var/data.
DATA_DIR=./data
# HTTP health endpoint for Render private/web services.
PORT=10000
